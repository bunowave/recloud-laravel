{
    "name": "bunowave/recloud-laravel",
    "description": "ReCloud Turnstile bot protection for Laravel: Blade component, validation rule, middleware and facade.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "captcha",
        "bot-protection",
        "turnstile",
        "recloud"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "BunoWave\\ReCloud\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BunoWave\\ReCloud\\ReCloudServiceProvider"
            ],
            "aliases": {
                "ReCloud": "BunoWave\\ReCloud\\Facades\\ReCloud"
            }
        }
    },
    "minimum-stability": "stable"
}
